    <title>Stay Stories | Beautiful Stays, Beautiful Stories</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            color: #28352c;
            background: #faf8f2;
        }
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px 8%;
            background: white;
        }
        .logo {
            font-size: 27px;
            font-weight: bold;
            color: #345846;
        }
        nav a {
            margin-left: 22px;
            color: #345846;
            text-decoration: none;
        }
        .hero {
            text-align: center;
            padding: 110px 20px;
            background: linear-gradient(90deg, #173c2b99, #173c2b55),
            url('https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=1800&q=85');
            background-position: center;
            background-size: cover;
            color: white;
        }
        .hero h1 {
            font-size: 48px;
            margin-bottom: 15px;
        }
        .hero p {
            font-size: 19px;
            line-height: 1.7;
        }
        .button {
            display: inline-block;
            margin-top: 20px;
            padding: 14px 25px;
            background: #d9b98b;
            color: #26372c;
            text-decoration: none;
            border-radius: 5px;
            font-weight: bold;
        }
        section {
            padding: 55px 8%;
            text-align: center;
        }
        .cards {
            display: flex;
            gap: 24px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            max-width: 270px;
            flex: 1;
        }
        footer {
            padding: 25px;
            background: #263f30;
            color: white;
            text-align: center;
        }
        @media (max-width: 600px) {
            header { flex-direction: column; gap: 15px; }
            nav a { margin: 0 7px; }
            .hero h1 { font-size: 34px; }
        }
    </style>
</head>
<body>
    <header>
